# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy HS256-signed projects; asymmetric keys are verified via JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=documents

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=study-assistant
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_MATERIALS_NAMESPACE=materials
PINECONE_PASTPAPERS_NAMESPACE=pastpapers
# Must match the index dimension. 3072 = native text-embedding-3-large.
# Use 1024 to allow Cohere embed-english-v3.0 as an embedding fallback.
EMBEDDING_DIMENSION=3072

# --- LLM providers (ordered: primary first, then fallbacks) ---
GENERATION_PROVIDERS=openai,anthropic,cohere
EMBEDDING_PROVIDERS=openai,cohere
LLM_MAX_ATTEMPTS=3
LLM_RETRY_MAX_WAIT_SECONDS=8

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Optional fallbacks
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest
COHERE_API_KEY=
COHERE_CHAT_MODEL=command-r-plus
COHERE_EMBEDDING_MODEL=embed-english-v3.0

# --- Notifications (Resend). Leave empty to log emails to the console. ---
RESEND_API_KEY=
EMAIL_FROM=Study Assistant <reports@yourdomain.com>

# --- End-of-day job ---
# Set ENABLE_SCHEDULER=true to run it inside the API process, or use cron + scripts/run_eod_job.py.
ENABLE_SCHEDULER=false
EOD_CRON_HOUR=20
EOD_CRON_MINUTE=0
EOD_TIMEZONE=UTC
